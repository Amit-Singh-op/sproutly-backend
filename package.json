{
  "name": "sproutly-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sproutly server: REST API, Socket.IO realtime and BullMQ worker (see docs/BACKEND.md in the app repo).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "dev:realtime": "tsx watch src/realtime/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev": "tsx src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/index.js",
    "start:realtime": "node dist/realtime/index.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
