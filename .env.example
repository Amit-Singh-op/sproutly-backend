NODE_ENV=development
DATABASE_URL=postgres://sproutly:sproutly@localhost:5433/sproutly
REDIS_URL=redis://localhost:6380

# Access tokens (15 min) and refresh tokens (30 days, rotated). Use 32+ random bytes each.
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Non-production only: this OTP always works and is returned to the app as devCode.
OTP_DEV_CODE=000000
# Store review account: this ONE email signs in with REVIEW_CODE (no email sent). Give both to Google Play under App access.
REVIEW_EMAIL=
REVIEW_CODE=
# Email OTP delivery via Gmail SMTP. GMAIL_APP_PASSWORD is a 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend (https://resend.com) API key. Preferred over SMTP; required on Render free tier.
RESEND_API_KEY=
# With Resend: an address on your verified domain, e.g. "Sproutly <no-reply@sproutly.app>".
# With Gmail SMTP (local only): optional, defaults to "Sproutly <GMAIL_USER>".
OTP_FROM=
# Optional: replies to sign-in emails go here (e.g. a support Gmail).
OTP_REPLY_TO=
# Optional: public https URL of a square PNG logo for emails (SVG doesn't work in Gmail/Outlook).
EMAIL_LOGO_URL=

# RevenueCat
# Shared secret RevenueCat sends in the Authorization header of webhooks.
REVENUECAT_WEBHOOK_AUTH=change-me-webhook-secret
# Secret (sk_...) API key, used by POST /v1/purchases/sync to read a subscriber right after purchase.
REVENUECAT_SECRET_KEY=

# Push (FCM HTTP v1). Leave empty to log pushes instead of sending them.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Or paste the service-account JSON here instead of a file path (easier on Render):
FCM_SERVICE_ACCOUNT_JSON=

# Apple / Google sign-in audiences (bundle id / OAuth client ids, comma separated)
APPLE_AUDIENCE=ai.sproutly.app
GOOGLE_AUDIENCES=

API_PORT=4000
RT_PORT=4001
CORS_ORIGINS=*

# Cloudinary (profile photos). Paste the "API environment variable" from the Cloudinary dashboard:
CLOUDINARY_URL=
# ...or set the three parts instead:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
